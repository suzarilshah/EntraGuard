# ── EntraGuard configuration ───────────────────────────────────────────────
# Copy to .env for local development. In Azure these are injected as Container
# App env vars; every credentialed call uses the user-assigned managed identity,
# so no secrets belong in this file outside local dev.

# ── Azure context ──
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-entraguard-demo

# ── Azure Communication Services ──
ACS_ENDPOINT=https://<acs-name>.communication.azure.com
# Local dev only. In Azure the managed identity replaces this.
ACS_CONNECTION_STRING=

# ── Callback / streaming host ──
# Public HTTPS base for the media service. Locally this is your dev tunnel:
#   devtunnel host -p 8080 --allow-anonymous
PUBLIC_BASE_URL=https://<tunnel-or-aca-fqdn>
# Shared secret used to sign the JWT that ACS presents on the media WebSocket.
MEDIA_WS_SIGNING_KEY=

# ── Azure AI Speech ──
SPEECH_ENDPOINT=https://<region>.api.cognitive.microsoft.com
SPEECH_REGION=eastus
SPEECH_KEY=

# ── Azure OpenAI ──
AOAI_ENDPOINT=https://<aoai-name>.openai.azure.com
AOAI_DEPLOYMENT=gpt-5-mini
AOAI_API_VERSION=2024-10-21
AOAI_KEY=

# ── Observability (Logs Ingestion API) ──
LAW_WORKSPACE_ID=
DCE_ENDPOINT=https://<dce-name>.<region>.ingest.monitor.azure.com
DCR_IMMUTABLE_ID=
DCR_STREAM_CALL_ANALYSIS=Custom-EntraGuard_CallAnalysis_CL
DCR_STREAM_REMEDIATION=Custom-EntraGuard_Remediation_CL

# ── Storage ──
STORAGE_ACCOUNT_NAME=
STORAGE_TABLE_SESSIONS=Sessions
STORAGE_BLOB_TRANSCRIPTS=transcripts

# ── Entra ID app registrations ──
ENTRA_PORTAL_CLIENT_ID=
ENTRA_SERVICE_CLIENT_ID=
ENTRA_QUARANTINE_GROUP_ID=

# ── Feature flags ──
# graph = tenant has Entra ID P2, confirmCompromised is live.
# degraded = no P2; remediation falls through to session revocation + Sentinel.
ENTRAGUARD_RISK_TIER=degraded
# ACS direct Entra ID user auth is public preview. false = server-side token broker.
ACS_ENTRA_DIRECT=false
