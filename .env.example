# Configuration reference — reviewed against Program.cs and the portal, September 2026.
# No runtime credentials here. Never commit a populated copy.
# ASP.NET Core does not automatically read a root .env: export these for its process.
# Next.js may use an uncommitted src/portal/.env.local during development.

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-entraguard-demo

# Media service: public HTTPS/WSS address reachable by ACS.
PUBLIC_BASE_URL=https://<media-hostname>
ACS_ENDPOINT=https://<acs-name>.communication.azure.com
# Optional local-only fallback; deployed Azure access uses managed identity.
ACS_CONNECTION_STRING=
ASPNETCORE_URLS=http://+:8080
# Explicit comma-separated browser origins; CORS is not authorization.
ALLOWED_ORIGINS=http://localhost:3000
# Required for path-bound ACS callback/media capabilities and the Event Grid webhook.
# Supply random secret values securely; do not commit populated copies.
CALLBACK_SIGNING_KEY=
EVENTGRID_WEBHOOK_KEY=
# Optional immutable home-tenant operator object IDs; app roles are preferred.
ENTRAGUARD_OPERATOR_IDS=
# Enables only the server-side SAMPLE payment ledger. No bank execution is implemented.
TREASURY_DEMO_LEDGER=true

SPEECH_ENDPOINT=https://<speech-name>.cognitiveservices.azure.com/
SPEECH_REGION=eastus
SPEECH_RESOURCE_ID=
SPEECH_LANGUAGE=en-US
AI_SERVICES_ENDPOINT=https://<ai-services-name>.cognitiveservices.azure.com/

AOAI_ENDPOINT=https://<aoai-name>.openai.azure.com/
AOAI_DEPLOYMENT=entraguard-analyst
AOAI_API_VERSION=2024-12-01-preview
# Optional runtime realtime connection. Empty means scripted prompts.
AOAI_REALTIME_ENDPOINT=
AOAI_REALTIME_DEPLOYMENT=
# Deploy-script switch; not read directly by the backend.
VOICE_AGENT=off

STORAGE_ACCOUNT_NAME=
LAW_RESOURCE_ID=
LAW_WORKSPACE_ID=
DCE_ENDPOINT=https://<dce-ingestion-hostname>
DCR_IMMUTABLE_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Five custom streams are defined in EntraGuardOptions; no stream env overrides are bound.
# Sessions/transcripts storage is provisioned but has no archive writer in this version.

# Frontend. APP_MODE=treasury serves the RP at /; omit for operator console mode.
APP_MODE=treasury
APP_PUBLIC_ORIGIN=http://localhost:3000
MEDIA_SERVICE_URL=http://localhost:8080
ENTRA_PORTAL_CLIENT_ID=
ENTRA_RP_CLIENT_ID=
ENTRA_RP_SCOPE=
# Multitenant service registration with workload identity federation and tenant consent.
ENTRA_SERVICE_CLIENT_ID=
ENTRA_QUARANTINE_GROUP_ID=
TEAMS_OBJECT_ID=
TEAMS_UPN=

ENTRAGUARD_RISK_TIER=degraded
# Blocks identity/call remediation; notifications/incidents can still be emitted.
ENTRAGUARD_SHADOW_MODE=true

VOICEPRINT_URL=
# Encryption secret required for enrollment; provide securely, never commit the value.
VOICEPRINT_KEY=
VOICE_MODE=observe
VOICE_REQUIRE_MFA=true
VOICE_ACCEPT=0.60
VOICE_REJECT=0.35
# MEDIA_WS_SIGNING_KEY is obsolete; CALLBACK_SIGNING_KEY signs callback/media URLs.
# SPEECH_KEY and AOAI_KEY are not bound; Azure access uses managed identity.

# ── External Authentication Method (EntraGuard as a second factor for any app) ──
# All three empty means the feature is off: discovery and JWKS return 404 and the
# authorization endpoint declines. Nothing else changes.
#
# EAM_KEYVAULT_URI  the vault holding the RS256 signing certificate. Created by
#                   infra/modules/keyvault.bicep and surfaced as its keyVaultUri output.
# EAM_CLIENT_ID     application ID of the multitenant registration Entra was configured
#                   with. It is the audience of every id_token_hint Entra sends and the
#                   audience of every token issued back, so a mismatch fails every sign-in.
# EAM_SIGNING_CERT  certificate name in that vault. Defaults to eam-signing.
EAM_KEYVAULT_URI=
EAM_CLIENT_ID=
EAM_SIGNING_CERT=eam-signing
