<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EntraGuard.MediaService</RootNamespace>
    <UserSecretsId>entraguard-mediaservice</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Call Automation 1.6.0 carries the GA bidirectional audio-streaming surface
         (MediaStreamingOptions.EnableBidirectional, OutStreamingData). -->
    <PackageReference Include="Azure.Communication.CallAutomation" Version="1.6.0" />
    <PackageReference Include="Azure.Communication.Identity" Version="1.3.1" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.51.1" />
    <!-- No Azure.AI.OpenAI / OpenAI package. Azure.AI.OpenAI 2.1.0 is compiled against
         OpenAI 2.1.0 and calls members removed by 2.12.0, so reaching ReasoningEffortLevel
         by pinning the newer package compiles cleanly and then throws MissingMethodException
         on every request. No pair of stable versions exposes the control this service needs,
         so AnalystClient talks to the REST API directly instead. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.Ingestion" Version="1.2.0" />
    <PackageReference Include="Azure.Data.Tables" Version="12.11.0" />
    <PackageReference Include="Azure.Messaging.EventGrid" Version="5.0.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EntraGuard.Shared/EntraGuard.Shared.csproj" />
  </ItemGroup>

</Project>
